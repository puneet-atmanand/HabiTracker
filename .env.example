# ─── Supabase Configuration ──────────────────────────────────────────────────
# Server-side environment variables (Set in Vercel Project Settings & .env.local)
# NEVER prefix with VITE_ to prevent client bundle exposure.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
TRACKER_USER_ID=your-existing-owner-user-uuid

# ─── Device Authorization Secret ─────────────────────────────────────────────
# Strong random 64-character hex key used to authorize laptop and phone
SYNC_DEVICE_KEY=your-strong-random-sync-device-key
